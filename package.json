{
  "name": "countdown-timer-plus",
  "version": "1.0.0",
  "description": "Cross-platform countdown timer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.boss.countdowntimer",
    "productName": "倒數計時器_plus",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable", "zip"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"]
    },
    "files": [
      "main.js",
      "index.html",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "png_type",
        "to": "png_type",
        "filter": ["**/*"]
      },
      {
        "from": "sound_type",
        "to": "sound_type",
        "filter": ["**/*"]
      }
    ]
  }
}